{
  "name": "@tomer/generator-js",
  "version": "5.1.0",
  "author": {
    "name": "Tomer Aberbach",
    "email": "tomer@aberba.ch",
    "url": "https://tomeraberba.ch"
  },
  "description": "A Yeoman generator for scaffolding my JavaScript modules.",
  "keywords": [
    "yeoman-generator"
  ],
  "homepage": "https://github.com/TomerAberbach/generator-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomerAberbach/generator-js.git"
  },
  "bugs": {
    "url": "https://github.com/TomerAberbach/generator-js/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/TomerAberbach"
  },
  "license": "MIT",
  "files": [
    "generators"
  ],
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "main": "generators/app/index.js",
  "scripts": {
    "format:base": "prettier --cache --write",
    "format": "pnpm format:base .",
    "lint:base": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix",
    "lint": "pnpm lint:base .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest",
    "build": "tsdown",
    "check": "run-p -c -l typecheck \"lint --no-fix\" \"format --no-write --check\" knip \"test --run\"",
    "prepublishOnly": "pnpm build"
  },
  "prettier": "@tomer/prettier-config",
  "dependencies": {
    "@sindresorhus/slugify": "3.0.1",
    "camelcase": "9.0.0",
    "github-username": "^9.0.0",
    "indefinite": "^2.5.2",
    "is-scoped": "3.0.0",
    "normalize-url": "9.0.1",
    "spdx-license-list": "6.12.0",
    "superb": "5.1.0",
    "yeoman-generator": "10.0.1"
  },
  "devDependencies": {
    "@tomer/eslint-config": "^6.0.0",
    "@tomer/prettier-config": "^5.0.0",
    "@types/indefinite": "^2.3.4",
    "@types/node": "^22.20.5",
    "@yeoman/adapter": "^5.1.0",
    "eslint": "^10.12.0",
    "knip": "^6.41.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "yeoman-environment": "^8.2.0"
  }
}
