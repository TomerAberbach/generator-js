{
  "name": "<%= moduleName %>",
  "version": "0.0.0",
  "author": {
    "name": "<%= name %>",
    "email": "<%= email %>",
    "url": "<%= website %>"
  },
  "description": "<%= moduleDescription %>",
  "keywords": [<% if (hasCli) { %>
    "cli"
  <% } %>],
  "homepage": "https://github.com/<%= githubUsername %>/<%= unscopedModuleName %>",
  "repository": "<%= githubUsername %>/<%= unscopedModuleName %>",
  "bugs": {
    "url": "https://github.com/<%= githubUsername %>/<%= unscopedModuleName %>/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/<%= githubUsername %>"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",<% if (hasLib) { %>
  "sideEffects": false,<% } %>
  "engines": {
    "node": ">= 22"
  },<% if (hasCli) { %>
  "bin": {
    "<%= unscopedModuleName %>": "./dist/cli/index.mjs"
  },<% } %><% if (hasLib) { %>
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },<% } %>
  "scripts": {
    "format:base": "prettier --cache --write",
    "format": "pnpm format:base .",
    "lint:base": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix",
    "lint": "pnpm lint:base .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "build": "tsdown",
    "check": "run-s -c build typecheck \"lint --no-fix\" \"format --no-write --check\" knip \"test --run\"",
    "prepublishOnly": "pnpm build"
  },
  "prettier": "@tomer/prettier-config"
}
